import subprocess
import shutil

def open_multiple_alerts():
    mask_art = (
        "               ▄▄▄▄████████▄▄▄▄\n"
        "            ▄████████████████████▄\n"
        "          ▄████████████████████████▄\n"
        "         ████████████████████████████\n"
        "        ████ ▀▀▀██████████████▀▀▀ ████\n"
        "       █████  ▄▄  ▀████████▀  ▄▄  █████\n"
        "       ██████████  ████████  ██████████\n"
        "       ██████████  ████████  ██████████\n"
        "       ██████▀▀▀   ████████   ▀▀▀██████\n"
        "       █████  ▄▄██████████████▄▄  █████\n"
        "        ████████████▀ ▀▀ ▀████████████\n"
        "         █████████ ▄██████▄ █████████\n"
        "          ▀██████ ▀▀      ▀▀ ██████▀\n"
        "            ▀██████▄      ▄██████▀\n"
        "               ▀▀████████████▀▀\n"
        "\n"
        "\033[1;31m=========================================\n"
        "       [!] SYSTEM DETECTED [!]\n"
        "           ВАС ОБНАРУЖИЛИ!\n"
        "=========================================\033[0m\n"
    )
    
    command_to_run = f"echo -e '{mask_art}'; bash -i"
    
    terminals = ['gnome-terminal', 'konsole', 'xfce4-terminal', 'mate-terminal', 'xterm']
    chosen_terminal = next((term for term in terminals if shutil.which(term)), None)
            
    if not chosen_terminal:
        print("Эмулятор терминала не найден.")
        return

    for _ in range(10):
        if chosen_terminal == 'gnome-terminal':
            subprocess.Popen([chosen_terminal, '--', 'bash', '-c', command_to_run])
        elif chosen_terminal == 'konsole':
            subprocess.Popen([chosen_terminal, '-e', 'bash', '-c', command_to_run])
        else:
            subprocess.Popen([chosen_terminal, '-e', f"bash -c \"{command_to_run}\""])

if __name__ == "__main__":
    open_multiple_alerts()
